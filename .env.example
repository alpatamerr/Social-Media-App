# ---- ImageKit (get from https://imagekit.io/dashboard/developer/api-keys) ----
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_URL=https://ik.imagekit.io/your_id

# ---- JWT secret (generate with: openssl rand -hex 32) ----
SECRET_KEY=your_secure_random_secret_key

# ---- Database ----
# Local SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./test.db
# Railway PostgreSQL (set this in Railway environment variables):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Frontend ----
# URL of the running FastAPI backend (used by frontend.py locally)
API_URL=http://localhost:8000
